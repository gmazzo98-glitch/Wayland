__pycache__/
*.pyc
.pytest_cache/

# Local demo database — the app auto-seeds a fresh one when empty (app.py),
# so shipping a stale binary snapshot isn't needed and just bloats the repo.
vienna.db

# Secrets — never commit real credentials. .env.example stays committed as the template.
.env
.streamlit/secrets.toml

# Internal strategy docs — confidential business/pricing detail, kept local only.
GG_Dashboard_Technical_Brief.docx
GG_Signal_Sourcing_Plan.docx

# Virtualenvs, in case one gets created locally
.venv/
venv/
env/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Throwaway ad-hoc test scripts, not part of the app
scratch/

# scripts/crawler_bench.py's own ad-hoc output (filenames are whatever --db/--out an
# invocation chose, e.g. bench_5.db, report_live.json) and pytest's --junitxml output —
# scratch artifacts from live-verifying a crawler ticket, not part of the app.
bench_*.db
bench_*.json
report_*.json
junit*.xml
logs_bench/
test_logs/
