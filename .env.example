# Copy to .env and fill in whichever you have. Every source runs in clearly-labeled
# simulated mode with none of these set — see each adapters/*.py or scrapers/*.py
# module docstring for what a var does and where to get it.

# adapters/epo_ops.py — free registration at epo.org/ops
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# adapters/euipo.py — free registration at dev.euipo.europa.eu
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
# Only override these if your EUIPO app dashboard shows different values:
# EUIPO_TOKEN_URL=
# EUIPO_SEARCH_URL=

# adapters/destatis.py — free registration at www-genesis.destatis.de
DESTATIS_USERNAME=
DESTATIS_PASSWORD=
# Specific GENESIS-Online table code for sector export exposure — not guessed,
# confirm the right table on genesis.destatis.de before setting this.
DESTATIS_EXPORT_TABLE_CODE=

# adapters/google_news.py — Google Cloud Console API key + a Programmable Search
# Engine (cse.google.com) configured to search the whole web
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# scrapers/bundesanzeiger_paid.py — leave false until the real Playwright+pdfplumber
# puller is built (flipping this without that raises loudly instead of faking data)
BUNDESANZEIGER_PAID_ENABLED=false

# scrapers/kununu_light.py — leave false until a company->Kununu-profile mapping
# or compliant reseller integration exists
KUNUNU_RESELLER_ENABLED=false

# adapters/eu_funding.py, adapters/arbeitsagentur.py — both live by default using
# publicly documented, non-secret values. Only set these if either publisher
# rotates their public key/id.
# EU_FUNDING_API_KEY=SEDIA
# ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche

# Optional — defaults to local SQLite (vienna.db) if unset
# DATABASE_URL=
