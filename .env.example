# Copy to .env and fill in whichever you have. Every source runs in clearly-labeled
# simulated mode with none of these set — see each adapters/*.py or scrapers/*.py
# module docstring for what a var does and where to get it.

# adapters/epo_ops.py — free registration at epo.org/ops
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=

# adapters/euipo.py — free registration at dev.euipo.europa.eu
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
# Only override these if your EUIPO app dashboard shows different values:
# EUIPO_TOKEN_URL=
# EUIPO_SEARCH_URL=

# adapters/destatis.py — free registration at www-genesis.destatis.de
DESTATIS_USERNAME=
DESTATIS_PASSWORD=
# Specific GENESIS-Online table code for sector export exposure — not guessed,
# confirm the right table on genesis.destatis.de before setting this.
DESTATIS_EXPORT_TABLE_CODE=

# adapters/google_news.py — Google Cloud Console API key + a Programmable Search
# Engine (cse.google.com) configured to search the whole web
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# scrapers/bundesanzeiger_paid.py — leave false until the real Playwright+pdfplumber
# puller is built (flipping this without that raises loudly instead of faking data)
BUNDESANZEIGER_PAID_ENABLED=false

# scrapers/kununu_light.py — leave false until a company->Kununu-profile mapping
# or compliant reseller integration exists
KUNUNU_RESELLER_ENABLED=false

# adapters/eu_funding.py, adapters/arbeitsagentur.py — both live by default using
# publicly documented, non-secret values. Only set these if either publisher
# rotates their public key/id.
# EU_FUNDING_API_KEY=SEDIA
# ARBEITSAGENTUR_API_KEY=jobboerse-jobsuche

# --- Phase 7: Node-based crawlers (scrapers/*_crawler.py), see Scraper/crawlers/ ---
# Only needed if the Scraper folder isn't a sibling of this project folder:
# SCRAPER_CRAWLERS_DIR=

# company-website-crawler — LLM field extraction (product lines, founding year, ESG
# report). Falls back to unextracted/not_found fields, not fake data, if unset. Defaults
# to Groq (console.groq.com/keys — free, no credit card, rate-limited only); override
# CRAWLER_LLM_BASE_URL/CRAWLER_LLM_MODEL to point at Gemini/Cerebras/a local Ollama
# instead, no code change needed either side.
# CRAWLER_LLM_API_KEY=
# CRAWLER_LLM_BASE_URL=https://api.groq.com/openai/v1
# CRAWLER_LLM_MODEL=llama-3.3-70b-versatile

# news-signals-crawler / innovation-participation-crawler — still call the Anthropic API
# directly for classification (unconverted; both are gated primarily on NEWSAPI_KEY
# below anyway, and their News/Press signals already run free via
# adapters/google_news_rss.py). Optional for both — missing key degrades quality, not a hard block.
# CRAWLER_ANTHROPIC_API_KEY=

# news-signals-crawler / innovation-participation-crawler — REQUIRED for either to run
# live at all. Without it they'd default to a fixed fake Wikipedia search fixture, so
# the wrappers skip straight to a clearly-tagged simulated value instead of calling out.
# NEWSAPI_KEY=

# digital-maturity-crawler — optional, improves tech-stack detection over the Wayback-only heuristic.
# BUILTWITH_API_KEY=

# linkedin-profile-crawler — OFF by default. The sourcing plan names LinkedIn a
# "highest-risk scrape target" and recommends a compliant reseller over direct scraping;
# flip this on only as a deliberate decision, and only once a company->profile-URL
# list exists via CompanyPerson.linkedin_url.
LINKEDIN_CRAWLER_ENABLED=false
# LINKEDIN_LI_AT=

# review-crawler's Kununu/Glassdoor employer-review mode (Mode B) — OFF by default,
# a fresh decision distinct from KUNUNU_RESELLER_ENABLED below (this one scrapes
# directly, respecting robots.txt, rather than going through a paid reseller).
# Google/Trustpilot product reviews (Mode A) always run regardless of this flag.
KUNUNU_CRAWLER_ENABLED=false

# Optional — defaults to local SQLite (vienna.db) if unset. To use the
# Supabase Postgres project instead, paste the Session pooler connection
# string from Supabase Dashboard -> Project -> Settings -> Database ->
# Connect -> Session pooler (NOT "Direct connection" — that one's IPv6-only
# and won't work from most home/office networks):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# review-crawler's Google Maps customer-review mode (Mode A) — OFF by default since the
# 2026-09-18 verification pass (Maps Terms of Service, GDPR consent auto-dismissal, and a
# trend that cannot be computed for firms with 4-67 reviews). See config.py.
REVIEW_CRAWLER_MODE_A_ENABLED=false

# Optional: keep every Node crawler's own stdout/stderr, one file per crawler, in this
# folder — what scripts/crawler_bench.py uses to read a crawl's log next to its signals.
# VIENNA_CRAWLER_LOG_DIR=
